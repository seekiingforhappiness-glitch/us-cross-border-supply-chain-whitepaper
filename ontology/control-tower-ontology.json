{
  "version": "0.4.0",
  "name": "cross_border_unified_ontology",
  "displayName": "跨境供应链统一 Ontology（控制塔 + SKU 准入 + 费用对账，三场景共享）",
  "scope": "Three scenarios on one ontology: (1) delay-risk control tower; (2) SKU admission & quote decision; (3) invoice reconciliation & cost anomaly loop REUSING the RiskEvent/Task closed loop (F1). Shared objects zero duplication.",
  "authority": "Human-readable sources: control-tower-ontology-manual.md (v0.2) + admission-manual-v0.3.md + cost-manual-v0.4.md. Decisions D1-D11, E1-E5, F1-F5 govern changes. Filename kept for reference stability.",
  "asOfPolicy": {
    "rule": "All engine evaluation and UI rendering take an explicit as_of_date parameter. Implicit system time is forbidden (D8)."
  },
  "primaryKeyPolicy": {
    "requiredPattern": "*_id",
    "rules": [
      "All object instances must use a stable unique primary key.",
      "Do not use any mutable display name as a primary key.",
      "Synthetic keys must be generated in the data preparation layer and persisted before application usage."
    ]
  },
  "roles": ["ops", "cs", "manager", "system", "sales", "compliance", "finance"],
  "sensitiveFieldRules": [
    {"object": "Customer", "field": "tier", "visibleTo": ["cs", "manager"]},
    {"object": "Task", "field": "proposal_params.est_cost_usd", "visibleTo": ["ops", "manager"]},
    {"object": "Customer", "field": "credit_terms", "visibleTo": ["finance", "manager"]},
    {"object": "Customer", "field": "risk_tier", "visibleTo": ["finance", "manager"]},
    {"object": "Supplier", "field": "uflpa_risk_flag", "visibleTo": ["compliance", "manager"]},
    {"object": "CostScenario", "field": "*_usd and margin fields", "visibleTo": ["finance", "manager"]},
    {"object": "AdmissionCase", "field": "conditions", "visibleTo": ["finance", "manager"]},
    {"rendering": "Fields hidden by permission must render as 'no access', never as blank/null. null must not be interpreted as 'no risk'."}
  ],
  "objects": [
    {
      "type": "Supplier",
      "primaryKey": "supplier_id",
      "titleKey": "supplier_name",
      "ownerRole": "ops",
      "properties": [
        {"name": "supplier_id", "type": "string", "required": true},
        {"name": "supplier_name", "type": "string", "required": true, "description": "Canonical name after entity resolution."},
        {"name": "city", "type": "string", "required": true},
        {"name": "lead_time_days", "type": "number", "required": true},
        {"name": "factory_audit_status", "type": "enum", "required": false, "values": ["not_started", "pending", "passed", "failed", "waived"], "description": "E2 admission fields; nullable."},
        {"name": "compliance_docs_status", "type": "enum", "required": false, "values": ["missing", "partial", "provided", "verified", "rejected"]},
        {"name": "uflpa_risk_flag", "type": "boolean", "required": false, "sensitive": true},
        {"name": "origin_evidence_status", "type": "enum", "required": false, "values": ["missing", "provided", "verified", "rejected"]}
      ],
      "dataQualityRules": ["supplier_id unique", "lead_time_days > 0"]
    },
    {
      "type": "Sku",
      "primaryKey": "sku_id",
      "titleKey": "sku_name",
      "ownerRole": "ops",
      "properties": [
        {"name": "sku_id", "type": "string", "required": true},
        {"name": "sku_name", "type": "string", "required": true},
        {"name": "category", "type": "enum", "required": true, "values": ["charger", "cable", "earbuds", "phone_case"]},
        {"name": "unit_price_usd", "type": "number", "required": true, "description": "Used for affected_value_usd."},
        {"name": "sku_status", "type": "enum", "required": true, "values": ["candidate", "active"], "description": "E1 lifecycle: admission targets candidates; approval promotes to active."},
        {"name": "declared_value_usd", "type": "number", "required": false, "description": "Admission fields (E1); nullable for legacy active SKUs."},
        {"name": "package_weight_kg", "type": "number", "required": false},
        {"name": "package_l_cm", "type": "number", "required": false},
        {"name": "package_w_cm", "type": "number", "required": false},
        {"name": "package_h_cm", "type": "number", "required": false},
        {"name": "battery_flag", "type": "boolean", "required": false},
        {"name": "food_contact_flag", "type": "boolean", "required": false},
        {"name": "children_product_flag", "type": "boolean", "required": false},
        {"name": "material", "type": "string", "required": false},
        {"name": "use_case", "type": "string", "required": false},
        {"name": "origin_country", "type": "string", "required": false},
        {"name": "platform", "type": "enum", "required": false, "values": ["amazon", "walmart", "tiktok_shop", "shopify", "other"]}
      ],
      "dataQualityRules": ["sku_id unique", "unit_price_usd > 0", "candidate skus must have regulatory flags explicit before precheck"]
    },
    {
      "type": "Customer",
      "primaryKey": "customer_id",
      "titleKey": "customer_name",
      "ownerRole": "cs",
      "properties": [
        {"name": "customer_id", "type": "string", "required": true},
        {"name": "customer_name", "type": "string", "required": true},
        {"name": "tier", "type": "enum", "required": true, "sensitive": true, "values": ["A", "B", "C"], "description": "Drives severity escalation in R1."},
        {"name": "us_state", "type": "string", "required": true},
        {"name": "business_model", "type": "enum", "required": false, "values": ["platform_seller", "brand_dtc", "trader", "service_provider", "other"], "description": "E2 admission fields; nullable."},
        {"name": "sales_channel", "type": "string", "required": false},
        {"name": "ior_capability", "type": "enum", "required": false, "values": ["has_ior", "needs_partner", "unknown"], "description": "DDP gate G2 depends on it."},
        {"name": "broker_status", "type": "enum", "required": false, "values": ["has_broker", "needs_broker", "unknown"]},
        {"name": "credit_terms", "type": "string", "required": false, "sensitive": true},
        {"name": "risk_tier", "type": "enum", "required": false, "sensitive": true, "values": ["low", "medium", "high", "critical"], "description": "Credit risk; distinct from commercial tier A/B/C."}
      ],
      "dataQualityRules": ["customer_id unique", "tier required (R1 depends on it)", "ior_capability must not be unknown before approving DDP (v0.1 rule)"]
    },
    {
      "type": "SalesOrder",
      "primaryKey": "so_id",
      "ownerRole": "cs",
      "properties": [
        {"name": "so_id", "type": "string", "required": true},
        {"name": "customer_id", "type": "string", "required": true},
        {"name": "order_date", "type": "date", "required": true},
        {"name": "status", "type": "enum", "required": true, "derived": true, "values": ["open", "in_fulfillment", "fulfilled", "cancelled"], "description": "Aggregated from line statuses; never written by actions."}
      ],
      "dataQualityRules": ["so_id unique", "must have >=1 line", "status is derived-only"]
    },
    {
      "type": "SalesOrderLine",
      "primaryKey": "so_line_id",
      "ownerRole": "cs",
      "statusField": "line_status",
      "properties": [
        {"name": "so_line_id", "type": "string", "required": true},
        {"name": "so_id", "type": "string", "required": true},
        {"name": "sku_id", "type": "string", "required": true},
        {"name": "qty", "type": "number", "required": true},
        {"name": "unit_price_usd", "type": "number", "required": true, "description": "Negotiated line price, not catalog price (D11); basis of affected_value_usd."},
        {"name": "promised_delivery_date", "type": "date", "required": true, "description": "Current promise; updated only by approved reschedule (A5)."},
        {"name": "original_promised_date", "type": "date", "required": true, "description": "Immutable after creation."},
        {"name": "reschedule_count", "type": "number", "required": true, "description": "Default 0; +1 per approved reschedule (D9/C1)."},
        {"name": "line_status", "type": "enum", "required": true, "values": ["open", "allocated", "at_risk", "fulfilled", "cancelled"]}
      ],
      "dataQualityRules": ["qty > 0", "promised_delivery_date >= order_date", "original_promised_date immutable"]
    },
    {
      "type": "PurchaseOrder",
      "primaryKey": "po_id",
      "ownerRole": "ops",
      "statusField": "status",
      "properties": [
        {"name": "po_id", "type": "string", "required": true},
        {"name": "supplier_id", "type": "string", "required": true},
        {"name": "sku_id", "type": "string", "required": true, "description": "Single-SKU PO (D2 simplification)."},
        {"name": "qty", "type": "number", "required": true},
        {"name": "po_date", "type": "date", "required": true},
        {"name": "expected_ready_date", "type": "date", "required": true},
        {"name": "status", "type": "enum", "required": true, "values": ["placed", "ready", "shipped", "closed", "cancelled"]}
      ],
      "dataQualityRules": ["po_id unique", "expected_ready_date >= po_date"]
    },
    {
      "type": "Shipment",
      "primaryKey": "shipment_id",
      "ownerRole": "ops",
      "statusField": "status",
      "properties": [
        {"name": "shipment_id", "type": "string", "required": true},
        {"name": "booking_no", "type": "string", "required": true, "description": "Booking number, SCAC+9 digits; real-world cross-system join key (D11)."},
        {"name": "mbl_no", "type": "string", "required": true, "description": "Master bill of lading number (D11)."},
        {"name": "mode", "type": "enum", "required": true, "values": ["ocean_fcl", "ocean_lcl"]},
        {"name": "container_no", "type": "string", "required": false, "description": "Demoted attribute (D5); nullable by noise."},
        {"name": "container_type", "type": "enum", "required": true, "values": ["40HC", "40GP", "20GP"], "description": "ISO size type (D11)."},
        {"name": "gross_weight_kg", "type": "number", "required": true, "description": "X12 315 B4 weight (D11)."},
        {"name": "volume_cbm", "type": "number", "required": true, "description": "X12 315 B4 cube (D11)."},
        {"name": "incoterm", "type": "enum", "required": true, "values": ["FOB", "CIF", "DDP"], "description": "Trade term (D11); foundation for v0.3 cost loop."},
        {"name": "vessel_voyage", "type": "string", "required": false, "description": "Demoted attribute; nullable by noise."},
        {"name": "carrier_name", "type": "string", "required": false, "description": "Demoted attribute; nullable by noise (name may be blank while SCAC present)."},
        {"name": "carrier_scac", "type": "enum", "required": true, "values": ["COSU", "OOLU", "MATS", "ZIMU", "EGLV"], "description": "Carrier SCAC code (D11)."},
        {"name": "origin_port", "type": "enum", "required": true, "values": ["yantian", "shekou", "ningbo"]},
        {"name": "origin_port_locode", "type": "enum", "required": true, "values": ["CNYTN", "CNSHK", "CNNGB"], "description": "UN/LOCODE (D11)."},
        {"name": "destination_port", "type": "enum", "required": true, "values": ["los_angeles", "long_beach"]},
        {"name": "destination_port_locode", "type": "enum", "required": true, "values": ["USLAX", "USLGB"], "description": "UN/LOCODE (D11)."},
        {"name": "destination_warehouse", "type": "string", "required": true},
        {"name": "etd", "type": "date", "required": true},
        {"name": "eta_initial", "type": "date", "required": true, "description": "Immutable after creation."},
        {"name": "eta_current", "type": "date", "required": true, "description": "Updated only by A1 IngestMilestone."},
        {"name": "ata", "type": "date", "required": false},
        {"name": "customs_status", "type": "enum", "required": true, "values": ["not_filed", "filed", "hold", "released"]},
        {"name": "missing_docs", "type": "list", "required": true, "itemValues": ["commercial_invoice", "packing_list", "bill_of_lading", "isf"], "description": "Empty list = complete."},
        {"name": "expedite_flag", "type": "boolean", "required": true, "description": "Set true by approved expedite (D9/C2 simplification)."},
        {"name": "delay_days", "type": "number", "derived": true, "description": "eta_current - eta_initial."},
        {"name": "status", "type": "enum", "required": true, "values": ["planned", "in_transit", "arrived", "customs", "delivered"]}
      ],
      "dataQualityRules": ["eta_initial >= etd", "eta_current writable only via A1", "delay_days derived-only"]
    },
    {
      "type": "ShipmentMilestone",
      "primaryKey": "milestone_id",
      "ownerRole": "system",
      "immutable": true,
      "properties": [
        {"name": "milestone_id", "type": "string", "required": true},
        {"name": "shipment_id", "type": "string", "required": true},
        {"name": "event_type", "type": "enum", "required": true, "values": ["booking_confirmed", "departed", "eta_change", "transshipment", "arrived", "customs_filed", "customs_hold", "customs_released", "delivered"]},
        {"name": "event_classifier", "type": "enum", "required": true, "values": ["ACT", "EST"], "description": "DCSA semantics (D11): eta_change=EST, others=ACT."},
        {"name": "event_time", "type": "datetime", "required": true, "description": "Business time; may arrive out of order."},
        {"name": "event_locode", "type": "string", "required": true, "description": "UN/LOCODE where the event occurred (D11); transshipment at hub e.g. SGSIN."},
        {"name": "new_eta", "type": "date", "required": false, "description": "Required iff event_type=eta_change."},
        {"name": "source_system", "type": "enum", "required": true, "values": ["carrier_edi", "forwarder_portal", "manual"]},
        {"name": "payload", "type": "json", "required": false},
        {"name": "ingested_at", "type": "datetime", "required": true},
        {"name": "is_duplicate", "type": "boolean", "derived": true, "description": "Set by pipeline; duplicates are kept but trigger no side effects."}
      ],
      "dataQualityRules": ["append-only, never update or delete", "eta_change requires new_eta", "duplicate = same (shipment_id, event_type, event_time, source_system)"]
    },
    {
      "type": "ShipmentAllocation",
      "primaryKey": "allocation_id",
      "ownerRole": "system",
      "description": "Hub object for impact propagation (D3).",
      "properties": [
        {"name": "allocation_id", "type": "string", "required": true},
        {"name": "shipment_id", "type": "string", "required": true},
        {"name": "so_line_id", "type": "string", "required": true},
        {"name": "allocated_qty", "type": "number", "required": true}
      ],
      "dataQualityRules": [
        "sum(allocated_qty) per so_line <= line.qty",
        "allocated sku must be in the sku set of the shipment's POs"
      ]
    },
    {
      "type": "RiskEvent",
      "primaryKey": "risk_event_id",
      "ownerRole": "system",
      "statusField": "status",
      "properties": [
        {"name": "risk_event_id", "type": "string", "required": true},
        {"name": "type", "type": "enum", "required": true, "values": ["delay_breach", "docs_missing", "stalled", "rate_overbilling", "duplicate_charge", "unplanned_charge"], "description": "Cost anomaly types added in v0.4 (F1: same closed loop)."},
        {"name": "rule_id", "type": "enum", "required": true, "values": ["R1", "R2", "R3", "R4", "R5", "R6"]},
        {"name": "severity", "type": "enum", "required": true, "values": ["medium", "high", "critical"]},
        {"name": "shipment_id", "type": "string", "required": true},
        {"name": "affected_so_line_ids", "type": "json_list", "required": true, "description": "JSON list, no join table (D9/C3). Empty list for cost anomalies."},
        {"name": "affected_invoice_line_ids", "type": "json_list", "required": false, "description": "v0.4 (P1): affected invoice lines for cost anomalies; null for logistics risks."},
        {"name": "affected_value_usd", "type": "number", "derived": true},
        {"name": "detected_at", "type": "date", "required": true, "description": "as_of_date at detection."},
        {"name": "root_cause", "type": "string", "required": true},
        {"name": "status", "type": "enum", "required": true, "values": ["open", "acknowledged", "mitigating", "resolved", "escalated"]},
        {"name": "resolved_at", "type": "date", "required": false},
        {"name": "outcome", "type": "enum", "required": false, "values": ["mitigated", "accepted_delay", "false_alarm", "escalated"]},
        {"name": "resolution_summary", "type": "string", "required": false, "description": "Required at close."}
      ],
      "dataQualityRules": ["no two non-terminal events for same (shipment_id, type) — A2 merges instead"]
    },
    {
      "type": "Task",
      "primaryKey": "task_id",
      "ownerRole": "ops",
      "statusField": "status",
      "properties": [
        {"name": "task_id", "type": "string", "required": true},
        {"name": "risk_event_id", "type": "string", "required": true},
        {"name": "title", "type": "string", "required": true},
        {"name": "assignee_role", "type": "enum", "required": true, "values": ["ops", "cs", "manager"]},
        {"name": "priority", "type": "enum", "required": true, "values": ["P1", "P2", "P3"]},
        {"name": "due_at", "type": "date", "required": true, "description": "Task handling deadline (when the handler must complete mitigation); NOT the delivery date or customer promise date."},
        {"name": "assignee_user_id", "type": "string", "required": false, "description": "M2 demo named owner from local roster; simulation-only, no real identity directory."},
        {"name": "assignee_team_id", "type": "string", "required": false, "description": "M2 demo team id such as team-ops-us."},
        {"name": "sla_state", "type": "enum", "required": false, "values": ["open", "due_today", "overdue"], "description": "Computed from explicit as_of_date and due_at."},
        {"name": "escalation_level", "type": "number", "required": false, "description": "M2 minimal semantics: 0 before/on due date, 1 after due date; no real notification or shift system."},
        {"name": "policy_version", "type": "string", "required": false, "description": "Demo assignment/SLA policy version."},
        {"name": "proposed_action", "type": "enum", "required": false, "values": ["expedite", "reschedule", "accept_delay"]},
        {"name": "proposal_params", "type": "json", "required": false, "sensitiveSubfields": ["est_cost_usd"]},
        {"name": "approval_status", "type": "enum", "required": false, "values": ["pending", "approved", "rejected"]},
        {"name": "approved_by_role", "type": "enum", "required": false},
        {"name": "assigned_by_actor_id", "type": "string", "required": false, "description": "M1 demo named actor; simulation-only, no real identity directory."},
        {"name": "proposal_actor_id", "type": "string", "required": false, "description": "M1 maker-checker proposer actor id."},
        {"name": "proposal_actor_role", "type": "enum", "required": false, "values": ["ops", "cs", "finance"]},
        {"name": "action_taken", "type": "string", "required": false},
        {"name": "status", "type": "enum", "required": true, "values": ["assigned", "in_progress", "done", "cancelled"]}
      ],
      "dataQualityRules": ["max 1 non-terminal task per risk_event (D9/C4)", "M1: if proposal_actor_id is known, approver actor_id must differ from proposer actor_id", "M2: demo named owner and SLA fields are deterministic simulation fields, not a real user directory"]
    },
    {
      "type": "AdmissionCase",
      "primaryKey": "admission_case_id",
      "titleKey": "case_title",
      "ownerRole": "sales creates / manager decides",
      "statusField": "status",
      "properties": [
        {"name": "admission_case_id", "type": "string", "required": true},
        {"name": "case_title", "type": "string", "required": true},
        {"name": "customer_id", "type": "string", "required": true},
        {"name": "sku_id", "type": "string", "required": true, "description": "Must be a candidate SKU (B1 precondition)."},
        {"name": "request_type", "type": "enum", "required": true, "values": ["new_sku", "ddp_quote", "dap_quote", "plan_review"]},
        {"name": "incoterm_candidate", "type": "enum", "required": true, "values": ["FOB", "DAP", "DDP", "tbd"]},
        {"name": "target_launch_date", "type": "date", "required": true},
        {"name": "monthly_order_estimate", "type": "number", "required": true},
        {"name": "risk_level", "type": "enum", "derived": true, "values": ["low", "medium", "high", "critical"], "description": "Max severity across findings; recomputed by B2."},
        {"name": "status", "type": "enum", "required": true, "values": ["draft", "in_precheck", "plan_ready", "priced", "approved", "quote_with_conditions", "rejected", "needs_more_info"]},
        {"name": "decision", "type": "enum", "required": false, "values": ["approve", "quote_with_conditions", "reject", "more_info"]},
        {"name": "decision_reason", "type": "string", "required": false, "description": "Required at terminal states."},
        {"name": "conditions", "type": "string", "required": false, "sensitive": true}
      ],
      "dataQualityRules": ["terminal states require decision_reason"]
    },
    {
      "type": "ComplianceFinding",
      "primaryKey": "compliance_finding_id",
      "titleKey": "finding_title",
      "ownerRole": "compliance",
      "properties": [
        {"name": "compliance_finding_id", "type": "string", "required": true},
        {"name": "admission_case_id", "type": "string", "required": true},
        {"name": "finding_title", "type": "string", "required": true},
        {"name": "finding_type", "type": "enum", "required": true, "values": ["hts", "pga", "labeling", "certification", "origin", "uflpa", "ad_cvd", "section_301", "platform_rule"]},
        {"name": "severity", "type": "enum", "required": true, "values": ["low", "medium", "high", "critical"]},
        {"name": "hts_candidate", "type": "string", "required": false, "description": "Required iff finding_type=hts (B2)."},
        {"name": "pga_agency", "type": "enum", "required": false, "values": ["CBP", "FDA", "FCC", "CPSC", "EPA", "USDA", "none"]},
        {"name": "required_document", "type": "string", "required": false},
        {"name": "evidence_status", "type": "enum", "required": true, "values": ["missing", "provided", "verified", "rejected"]},
        {"name": "recommendation", "type": "enum", "required": true, "values": ["accept", "more_docs", "dap_only", "reject", "escalate"]}
      ],
      "dataQualityRules": ["finding_type=hts requires hts_candidate"]
    },
    {
      "type": "LogisticsPlan",
      "primaryKey": "logistics_plan_id",
      "titleKey": "plan_name",
      "ownerRole": "ops",
      "properties": [
        {"name": "logistics_plan_id", "type": "string", "required": true},
        {"name": "admission_case_id", "type": "string", "required": true},
        {"name": "plan_name", "type": "string", "required": true},
        {"name": "route_type", "type": "enum", "required": true, "values": ["express", "air_freight", "ocean_fcl", "ocean_lcl", "warehouse_fulfillment"], "description": "ocean_parcel removed (N4)."},
        {"name": "incoterm", "type": "enum", "required": true, "values": ["FOB", "DAP", "DDP"]},
        {"name": "origin_port_locode", "type": "enum", "required": true, "values": ["CNYTN", "CNSHK", "CNNGB"], "description": "Aligned with D11 (N2)."},
        {"name": "destination_port_locode", "type": "enum", "required": true, "values": ["USLAX", "USLGB"]},
        {"name": "us_warehouse_region", "type": "enum", "required": true, "values": ["west", "central", "east", "platform"]},
        {"name": "last_mile_method", "type": "enum", "required": true, "values": ["UPS", "FedEx", "USPS", "OnTrac", "LTL", "platform"]},
        {"name": "estimated_transit_days", "type": "number", "required": true},
        {"name": "sla_risk", "type": "enum", "required": true, "values": ["low", "medium", "high"]},
        {"name": "operational_notes", "type": "string", "required": false}
      ],
      "dataQualityRules": ["DDP plan requires customer has_ior and an hts_candidate finding (gate, enforced by B3)"]
    },
    {
      "type": "CostScenario",
      "primaryKey": "cost_scenario_id",
      "titleKey": "scenario_type",
      "ownerRole": "finance",
      "properties": [
        {"name": "cost_scenario_id", "type": "string", "required": true},
        {"name": "logistics_plan_id", "type": "string", "required": true},
        {"name": "scenario_type", "type": "enum", "required": true, "values": ["conservative", "base", "optimistic"]},
        {"name": "quote_price_usd", "type": "number", "required": true, "sensitive": true, "description": "Added in v0.3 (N1): v0.1 had margin fields but no price."},
        {"name": "product_cost_usd", "type": "number", "required": true, "sensitive": true},
        {"name": "first_mile_cost_usd", "type": "number", "required": true, "sensitive": true},
        {"name": "international_freight_usd", "type": "number", "required": true, "sensitive": true},
        {"name": "duty_tax_usd", "type": "number", "required": true, "sensitive": true},
        {"name": "customs_brokerage_usd", "type": "number", "required": true, "sensitive": true},
        {"name": "warehouse_cost_usd", "type": "number", "required": true, "sensitive": true},
        {"name": "last_mile_cost_usd", "type": "number", "required": true, "sensitive": true},
        {"name": "returns_allowance_usd", "type": "number", "required": true, "sensitive": true},
        {"name": "risk_buffer_usd", "type": "number", "required": true, "sensitive": true},
        {"name": "gross_margin_usd", "type": "number", "derived": true, "sensitive": true, "description": "quote - sum(costs)."},
        {"name": "gross_margin_rate", "type": "number", "derived": true, "sensitive": true}
      ],
      "dataQualityRules": ["DDP scenario requires duty_tax>0, customs_brokerage>0, risk_buffer>0 (gate, enforced by B4)"]
    },
    {
      "type": "Container",
      "primaryKey": "container_no",
      "ownerRole": "ops",
      "properties": [
        {"name": "container_no", "type": "string", "required": true, "description": "ISO 6346 with check digit (F2, repays D5 debt)."},
        {"name": "shipment_id", "type": "string", "required": true, "description": "Shipment 1:N containers."},
        {"name": "container_type", "type": "enum", "required": true, "values": ["40HC", "40GP", "20GP"]},
        {"name": "is_primary", "type": "boolean", "required": true, "description": "Migration marker: matches legacy shipment.container_no."},
        {"name": "free_days", "type": "number", "required": true, "description": "Free time before detention; basis for DET attribution (F4)."},
        {"name": "gross_weight_kg", "type": "number", "required": true},
        {"name": "volume_cbm", "type": "number", "required": true}
      ],
      "dataQualityRules": ["valid ISO 6346 check digit", "every shipment has >=1 container with exactly one primary"]
    },
    {
      "type": "Invoice",
      "primaryKey": "invoice_id",
      "ownerRole": "finance",
      "statusField": "status",
      "properties": [
        {"name": "invoice_id", "type": "string", "required": true},
        {"name": "vendor_type", "type": "enum", "required": true, "values": ["carrier", "forwarder", "warehouse", "last_mile"]},
        {"name": "vendor_name", "type": "string", "required": true},
        {"name": "vendor_invoice_no", "type": "string", "required": true, "description": "Vendor's own number; real-world reconciliation key."},
        {"name": "shipment_id", "type": "string", "required": true},
        {"name": "issue_date", "type": "date", "required": true},
        {"name": "currency", "type": "enum", "required": true, "values": ["USD"]},
        {"name": "total_usd", "type": "number", "required": true, "description": "Must equal sum of line amounts (DQ)."},
        {"name": "status", "type": "enum", "required": true, "values": ["received", "under_review", "disputed", "approved"]}
      ],
      "dataQualityRules": ["total_usd == sum(lines.amount_usd)"]
    },
    {
      "type": "InvoiceLine",
      "primaryKey": "invoice_line_id",
      "ownerRole": "finance",
      "properties": [
        {"name": "invoice_line_id", "type": "string", "required": true},
        {"name": "invoice_id", "type": "string", "required": true},
        {"name": "charge_code", "type": "enum", "required": true, "values": ["OFT", "THC", "DOC", "FSC", "CUS", "DTY", "WHS", "STO", "LMD", "DET", "DEM", "CHS", "ACC"]},
        {"name": "container_no", "type": "string", "required": false, "description": "Required for container-level charges (THC/DET/DEM/CHS)."},
        {"name": "qty", "type": "number", "required": true},
        {"name": "unit_price_usd", "type": "number", "required": true},
        {"name": "amount_usd", "type": "number", "required": true, "description": "qty x unit_price (DQ)."}
      ],
      "dataQualityRules": ["amount = qty * unit_price", "container-level charge codes require container_no"]
    },
    {
      "type": "ExpectedCost",
      "primaryKey": "expected_cost_id",
      "ownerRole": "system",
      "properties": [
        {"name": "expected_cost_id", "type": "string", "required": true},
        {"name": "shipment_id", "type": "string", "required": true},
        {"name": "charge_code", "type": "enum", "required": true, "values": ["OFT", "THC", "DOC", "FSC", "CUS", "DTY", "WHS", "STO", "LMD"], "description": "DET/DEM/ACC/CHS deliberately absent = unplanned (R6 basis, F3)."},
        {"name": "container_no", "type": "string", "required": false},
        {"name": "baseline_usd", "type": "number", "required": true},
        {"name": "source", "type": "string", "required": true, "description": "rate_card (only source in v0.4)."}
      ],
      "dataQualityRules": ["baseline_usd > 0"]
    }
  ],
  "links": [
    {"linkType": "customer_places", "source": "Customer", "target": "SalesOrder", "cardinality": "1:N"},
    {"linkType": "so_has_line", "source": "SalesOrder", "target": "SalesOrderLine", "cardinality": "1:N", "rule": "no orphan lines"},
    {"linkType": "line_for_sku", "source": "SalesOrderLine", "target": "Sku", "cardinality": "N:1"},
    {"linkType": "supplier_provides", "source": "Supplier", "target": "Sku", "cardinality": "1:N", "rule": "single supplier per sku in v0.2"},
    {"linkType": "po_from_supplier", "source": "PurchaseOrder", "target": "Supplier", "cardinality": "N:1"},
    {"linkType": "po_shipped_by", "source": "PurchaseOrder", "target": "Shipment", "cardinality": "N:1", "rule": "one shipment carries multiple POs (D2)"},
    {"linkType": "shipment_has_milestone", "source": "Shipment", "target": "ShipmentMilestone", "cardinality": "1:N", "rule": "append-only"},
    {"linkType": "allocation_to_shipment", "source": "ShipmentAllocation", "target": "Shipment", "cardinality": "N:1"},
    {"linkType": "allocation_to_line", "source": "ShipmentAllocation", "target": "SalesOrderLine", "cardinality": "N:1"},
    {"linkType": "risk_on_shipment", "source": "RiskEvent", "target": "Shipment", "cardinality": "N:1"},
    {"linkType": "risk_affects_line", "source": "RiskEvent", "target": "SalesOrderLine", "cardinality": "N:M", "via": "affected_so_line_ids"},
    {"linkType": "task_handles_risk", "source": "Task", "target": "RiskEvent", "cardinality": "N:1"},
    {"linkType": "case_has_sku", "source": "AdmissionCase", "target": "Sku", "cardinality": "N:1", "rule": "targets candidate SKU"},
    {"linkType": "case_for_customer", "source": "AdmissionCase", "target": "Customer", "cardinality": "N:1", "rule": "SAME Customer object as control tower (reuse proof, E2)"},
    {"linkType": "case_has_finding", "source": "AdmissionCase", "target": "ComplianceFinding", "cardinality": "1:N"},
    {"linkType": "case_has_plan", "source": "AdmissionCase", "target": "LogisticsPlan", "cardinality": "1:N"},
    {"linkType": "plan_has_scenario", "source": "LogisticsPlan", "target": "CostScenario", "cardinality": "1:N"},
    {"linkType": "shipment_has_container", "source": "Shipment", "target": "Container", "cardinality": "1:N", "rule": "F2: one primary per shipment"},
    {"linkType": "invoice_for_shipment", "source": "Invoice", "target": "Shipment", "cardinality": "N:1"},
    {"linkType": "invoice_has_line", "source": "Invoice", "target": "InvoiceLine", "cardinality": "1:N"},
    {"linkType": "line_bills_container", "source": "InvoiceLine", "target": "Container", "cardinality": "N:1", "rule": "nullable for shipment-level charges"},
    {"linkType": "expected_cost_of_shipment", "source": "ExpectedCost", "target": "Shipment", "cardinality": "N:1"},
    {"linkType": "risk_affects_invoice_line", "source": "RiskEvent", "target": "InvoiceLine", "cardinality": "N:M", "via": "affected_invoice_line_ids (P1)"}
  ],
  "stateMachines": {
    "Shipment": {
      "states": ["planned", "in_transit", "arrived", "customs", "delivered"],
      "transitions": [
        {"from": "planned", "to": "in_transit", "trigger": "A1(departed)"},
        {"from": "in_transit", "to": "arrived", "trigger": "A1(arrived)"},
        {"from": "arrived", "to": "customs", "trigger": "A1(customs_filed|customs_hold|customs_released)"},
        {"from": "customs", "to": "delivered", "trigger": "A1(delivered)"}
      ],
      "notes": "departed state removed (D9/C5). delayed is a derived flag, not a state."
    },
    "SalesOrderLine": {
      "states": ["open", "allocated", "at_risk", "fulfilled", "cancelled"],
      "transitions": [
        {"from": "open", "to": "allocated", "trigger": "allocation (data build)"},
        {"from": "allocated", "to": "at_risk", "trigger": "A2"},
        {"from": "at_risk", "to": "allocated", "trigger": "A5(approved reschedule|expedite)", "notes": "re-entry, not terminal (D9/C1); re-breach re-alarms"},
        {"from": "at_risk", "to": "fulfilled", "trigger": "delivery confirmation"},
        {"from": "allocated", "to": "fulfilled", "trigger": "delivery confirmation"},
        {"from": "open", "to": "cancelled", "trigger": "cancellation"},
        {"from": "allocated", "to": "cancelled", "trigger": "cancellation"}
      ]
    },
    "RiskEvent": {
      "states": ["open", "acknowledged", "mitigating", "resolved", "escalated"],
      "transitions": [
        {"from": "open", "to": "acknowledged", "trigger": "A3"},
        {"from": "acknowledged", "to": "mitigating", "trigger": "A4"},
        {"from": "mitigating", "to": "resolved", "trigger": "A6(outcome=mitigated|accepted_delay|false_alarm)"},
        {"from": "open", "to": "escalated", "trigger": "A6(outcome=escalated)"},
        {"from": "acknowledged", "to": "escalated", "trigger": "A6(outcome=escalated)"},
        {"from": "mitigating", "to": "escalated", "trigger": "A6(outcome=escalated)"}
      ]
    },
    "Task": {
      "states": ["assigned", "in_progress", "done", "cancelled"],
      "transitions": [
        {"from": "assigned", "to": "in_progress", "trigger": "A4"},
        {"from": "in_progress", "to": "done", "trigger": "A5(approved)"},
        {"from": "in_progress", "to": "assigned", "trigger": "A5(rejected)", "notes": "proposal retained in action_log"},
        {"from": "assigned", "to": "cancelled", "trigger": "linked risk closed as false_alarm"},
        {"from": "in_progress", "to": "cancelled", "trigger": "linked risk closed as false_alarm"}
      ],
      "notes": "created state removed (D9/C6)."
    },
    "AdmissionCase": {
      "states": ["draft", "in_precheck", "plan_ready", "priced", "approved", "quote_with_conditions", "rejected", "needs_more_info"],
      "transitions": [
        {"from": "draft", "to": "in_precheck", "trigger": "B2"},
        {"from": "in_precheck", "to": "plan_ready", "trigger": "B3"},
        {"from": "plan_ready", "to": "priced", "trigger": "B4"},
        {"from": "priced", "to": "approved", "trigger": "B5(approve)"},
        {"from": "priced", "to": "quote_with_conditions", "trigger": "B5(quote_with_conditions)"},
        {"from": "any_non_terminal", "to": "rejected", "trigger": "B6(reject, manager only)"},
        {"from": "any_non_terminal", "to": "needs_more_info", "trigger": "B6(more_info)"},
        {"from": "needs_more_info", "to": "in_precheck", "trigger": "B2", "notes": "补资料回流，非终态（同 C1 思想）"}
      ],
      "notes": "Terminal: approved / quote_with_conditions / rejected. quote_with_conditions promoted to a status (N3)."
    },
    "Invoice": {
      "states": ["received", "under_review", "disputed", "approved"],
      "transitions": [
        {"from": "received", "to": "approved", "trigger": "MatchInvoice (no anomaly)"},
        {"from": "received", "to": "under_review", "trigger": "MatchInvoice (anomaly found)"},
        {"from": "under_review", "to": "disputed", "trigger": "A5(approved dispute)"},
        {"from": "under_review", "to": "approved", "trigger": "A5(approved accept_charge | rebill_customer)"}
      ],
      "notes": "Terminal: disputed (handed to claims process) / approved (pay as billed)."
    }
  },
  "actions": [
    {
      "id": "A1",
      "name": "IngestMilestone",
      "signature": "ingest_milestone(shipment_id, event_type, event_time, source_system, new_eta=None, payload=None, as_of_date=...) -> Result",
      "executors": ["system"],
      "preconditions": ["shipment exists", "eta_change requires new_eta", "exact duplicate -> store with is_duplicate=true and skip ALL side effects"],
      "successEffects": ["append milestone", "if event_time newer than last applied: update eta_current / customs_status / state transition", "trigger risk detection for shipment as_of event date"],
      "failureHandling": ["unknown shipment -> reject", "illegal transition -> store event, no transition, return warning, count in DQ report"],
      "audit": ["source_system", "rules_triggered", "duplicate_flag"]
    },
    {
      "id": "A2",
      "name": "CreateRiskEvent",
      "signature": "create_risk_event(shipment_id, rule_id, type, severity, affected_so_line_ids, root_cause, as_of_date, actor='system') -> Result",
      "executors": ["system", "ops"],
      "preconditions": ["affected lines non-empty for delay_breach", "existing non-terminal (shipment,type) event -> merge (max severity, union lines), return existing id"],
      "successEffects": ["RiskEvent=open", "affected SOLines -> at_risk", "compute affected_value_usd"],
      "failureHandling": ["line without allocation to shipment -> reject"],
      "audit": ["rule_id", "merged_or_created"]
    },
    {
      "id": "A3",
      "name": "AssignTask",
      "signature": "assign_task(risk_event_id, assignee_role, priority, due_at, actor) -> Result",
      "executors": ["system", "ops"],
      "preconditions": ["RiskEvent in {open}", "no non-terminal task for this risk"],
      "successEffects": ["Task=assigned", "RiskEvent -> acknowledged", "M2 demo assignee_user_id/assignee_team_id/sla_state/escalation_level/policy_version written"],
      "failureHandling": ["existing non-terminal task -> reject, return its id", "terminal risk -> reject"],
      "audit": ["assignee_role", "priority", "assignee_user_id", "assignee_team_id", "sla_state", "escalation_level", "policy_version"]
    },
    {
      "id": "A4",
      "name": "ProposeMitigation",
      "signature": "propose_mitigation(task_id, proposed_action, proposal_params, actor, role) -> Result",
      "executors": ["ops", "cs", "finance"],
      "paramsSchema": {
        "expedite": {"new_mode": "air", "est_cost_usd": "number", "expected_new_eta": "date"},
        "reschedule": {"new_promise_date": "date", "notify_customer": true},
        "accept_delay": {"reason": "string"},
        "dispute": {"reason": "string", "disputed_amount_usd": "number"},
        "accept_charge": {"reason": "string"},
        "rebill_customer": {"rebill_amount_usd": "number", "incoterm_basis": "string"}
      },
      "executorsNote": "v0.4 (P3): executors extended to ops/cs/finance; cost proposals belong to finance.",
      "preconditions": ["Task=assigned", "params match schema", "reschedule: new_promise_date > current promise"],
      "successEffects": ["Task -> in_progress, approval_status=pending", "proposal_actor_id/proposal_actor_role recorded", "RiskEvent -> mitigating"],
      "failureHandling": ["schema validation fails -> reject, task unchanged"],
      "audit": ["proposed_action", "params (est_cost_usd masked per sensitiveFieldRules)", "actor", "role"]
    },
    {
      "id": "A5",
      "name": "ApproveMitigation",
      "signature": "approve_mitigation(task_id, decision, comment, actor, role='manager') -> Result",
      "executors": ["manager"],
      "preconditions": ["approval_status=pending", "M1 maker-checker: if proposer actor is known, approver actor_id must differ from proposal_actor_id"],
      "successEffects": {
        "approved.reschedule": ["affected SOLines: promised_delivery_date=new_promise_date, reschedule_count+1, at_risk->allocated"],
        "approved.expedite": ["shipment.expedite_flag=true", "affected SOLines: at_risk->allocated (D9/C2 simplification)"],
        "approved.accept_delay": ["lines stay at_risk until delivery", "risk closable as accepted_delay"],
        "approved.common": ["Task->done", "action_taken summary"],
        "rejected": ["Task->assigned", "approval_status=rejected", "proposal retained in action_log"]
      },
      "failureHandling": ["non-manager caller -> reject AND audit the violation attempt", "same proposer/approver actor -> reject AND audit maker-checker violation"],
      "audit": ["decision", "comment", "approved_by_role", "approver actor; maker-checker failures include proposer/approver actor ids"]
    },
    {
      "id": "A6",
      "name": "CloseRiskEvent",
      "signature": "close_risk_event(risk_event_id, outcome, resolution_summary, actor_role) -> Result",
      "executors": ["ops"],
      "preconditions": ["all tasks terminal", "outcome=mitigated requires an approved proposal", "outcome=false_alarm cancels non-terminal tasks then closes"],
      "successEffects": ["RiskEvent -> resolved (or escalated)", "resolved_at / resolution_summary written"],
      "failureHandling": ["non-terminal task and outcome != false_alarm -> reject"],
      "audit": ["outcome", "resolution_summary"]
    },
    {
      "id": "B1", "name": "CreateAdmissionCase",
      "signature": "create_admission_case(customer_id, sku_id, request_type, incoterm_candidate, target_launch_date, monthly_order_estimate, actor, role) -> Result",
      "executors": ["sales"],
      "preconditions": ["customer and sku exist", "sku_status=candidate"],
      "successEffects": ["AdmissionCase created, status=draft"],
      "failureHandling": ["active SKU -> reject (re-review flow is v0.4)"],
      "audit": ["request_type", "incoterm_candidate"]
    },
    {
      "id": "B2", "name": "RunCompliancePrecheck",
      "signature": "run_compliance_precheck(admission_case_id, findings, actor, role) -> Result",
      "executors": ["compliance"],
      "preconditions": ["case in {draft,in_precheck,needs_more_info}", "each finding passes schema", "finding_type=hts requires hts_candidate"],
      "successEffects": ["findings written", "case -> in_precheck", "case.risk_level = max severity"],
      "failureHandling": ["schema failure -> reject whole batch, nothing written"],
      "audit": ["finding count", "max severity"]
    },
    {
      "id": "B3", "name": "BuildLogisticsPlan",
      "signature": "build_logistics_plan(admission_case_id, plan, actor, role) -> Result",
      "executors": ["ops"],
      "preconditions": ["case in {in_precheck,plan_ready}", "DDP gate: customer.ior_capability=has_ior AND exists finding with hts_candidate"],
      "successEffects": ["LogisticsPlan created", "case -> plan_ready"],
      "failureHandling": ["DDP missing IOR/HTS -> reject with missing items"],
      "audit": ["route_type", "incoterm"]
    },
    {
      "id": "B4", "name": "CalculateCostScenario",
      "signature": "calculate_cost_scenario(logistics_plan_id, scenario, actor, role) -> Result",
      "executors": ["finance"],
      "preconditions": ["plan exists", "case in {plan_ready,priced}", "DDP scenario: duty_tax>0 AND customs_brokerage>0 AND risk_buffer>0"],
      "successEffects": ["CostScenario created with computed margin", "case -> priced"],
      "failureHandling": ["DDP missing duty/brokerage/buffer -> reject"],
      "audit": ["scenario_type", "gross_margin_rate"]
    },
    {
      "id": "B5", "name": "ApproveQuoteDecision",
      "signature": "approve_quote_decision(admission_case_id, approved_logistics_plan_id, approved_cost_scenario_id, decision, decision_reason, conditions, actor, role) -> Result",
      "executors": ["manager"],
      "preconditions": [
        "G1: no unresolved critical finding (severity=critical AND evidence_status!=verified)",
        "G2: if approved plan is DDP then customer.ior_capability=has_ior",
        "G3: case=priced AND referenced plan/scenario exist",
        "M1 maker-checker: if selected quote proposer can be inferred, approver actor_id must differ from proposer actor_id"],
      "successEffects": ["case -> approved | quote_with_conditions", "decision/reason/conditions written", "if approve: sku_status candidate->active (E1/N5)"],
      "failureHandling": ["any gate -> reject AND audit (admission-side guardrail assertions)", "same inferred proposer/approver actor -> reject AND audit maker-checker violation"],
      "audit": ["decision", "decision_reason", "gates_checked"]
    },
    {
      "id": "B6", "name": "RejectOrRequestMoreInfo",
      "signature": "reject_or_request_more_info(admission_case_id, decision, missing_documents, rejection_reason, actor, role) -> Result",
      "executors": ["compliance (more_info)", "manager (reject)"],
      "preconditions": ["case non-terminal", "reject requires rejection_reason", "more_info requires missing_documents"],
      "successEffects": ["case -> rejected | needs_more_info"],
      "failureHandling": ["missing reason/documents -> reject"],
      "audit": ["decision", "missing_documents", "rejection_reason"]
    }
  ],
  "riskRules": [
    {"id": "R1", "type": "delay_breach", "logic": "shipment.eta_current + config.customs_buffer_days + config.lastmile_buffer_days > line.promised_delivery_date (via allocations); skip delivered shipments and fulfilled/cancelled lines", "severity": "per-line: breach<=3d medium, >3d high, tier=A +1 level; event severity = max over affected lines"},
    {"id": "R2", "type": "docs_missing", "logic": "missing_docs non-empty AND (eta_current - as_of_date) < 7d; skip delivered shipments and customs_status=released", "severity": "high"},
    {"id": "R3", "type": "stalled", "logic": "status=in_transit AND as_of_date - latest milestone.event_time >= config.stall_days", "severity": "medium"},
    {"id": "R4", "type": "rate_overbilling", "logic": "invoice_line.amount > expected_cost.baseline * (1 + config.rate_tolerance); affected_value = overbilled portion", "severity": "overbilling >20%: high; else medium"},
    {"id": "R5", "type": "duplicate_charge", "logic": "same (shipment, charge_code, container_no) billed on >1 line across/within invoices; lines beyond first are duplicates", "severity": "high"},
    {"id": "R6", "type": "unplanned_charge", "logic": "line whose charge_code has no ExpectedCost baseline (DET/DEM/ACC/CHS); DET/DEM on delayed shipments must cite delay attribution in root_cause (F4)", "severity": "amount > 500: high; else medium"}
  ],
  "config": {
    "customs_buffer_days": 3,
    "lastmile_buffer_days": 2,
    "stall_days": 5,
    "rate_tolerance": 0.05,
    "unplanned_high_threshold_usd": 500,
    "note": "Values live in config/*.yaml; these are defaults, not hardcoded constants."
  },
  "incotermRebillMatrix": {
    "DDP": [],
    "CIF": ["DTY", "CUS", "WHS", "STO", "LMD", "DET", "DEM", "CHS", "ACC"],
    "FOB": ["OFT", "FSC", "THC", "DOC", "DTY", "CUS", "WHS", "STO", "LMD", "DET", "DEM", "CHS", "ACC"],
    "note": "G4 gate (F5/P4): keyed to Shipment.incoterm enum (FOB/CIF/DDP). rebill approval requires affected charge codes within matrix."
  },
  "auditLog": {
    "table": "action_log",
    "fields": ["actor", "role", "action", "target_object_id", "params_json", "as_of_date", "timestamp", "result"],
    "rules": ["every state change has exactly one action_log row", "rejected/unauthorized attempts are also logged with failure reason"]
  }
}
