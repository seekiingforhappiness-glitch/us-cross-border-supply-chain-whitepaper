{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "control-tower",
      "runtimeExecutable": "streamlit",
      "runtimeArgs": [
        "run",
        "app/streamlit_app.py",
        "--server.port",
        "8502",
        "--server.headless",
        "true"
      ],
      "port": 8502
    },
    {
      "name": "cockpit",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/cockpit", "run", "dev"],
      "port": 5174
    }
  ]
}
